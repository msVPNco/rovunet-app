<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><ApplicationIcon>Assets/rovunet.ico</ApplicationIcon><EnableWindowsTargeting>true</EnableWindowsTargeting><AssemblyName>Rovunet</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest></PropertyGroup>
  <PropertyGroup><UseWindowsForms>true</UseWindowsForms></PropertyGroup>
  <!-- WPF owns startup and DPI via its native manifest. WinForms is used only
       for the tray icon; its ApplicationConfiguration startup advice does not apply. -->
  <PropertyGroup><NoWarn>$(NoWarn);WFO0003</NoWarn></PropertyGroup>
  <ItemGroup><Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/><ProjectReference Include="../Rovunet.Platform/Rovunet.Platform.csproj" /><EmbeddedResource Include="Locales/*.json" /><Resource Include="Assets/*.ttf" /><Resource Include="Assets/Support/*.png" /><EmbeddedResource Include="../../transports/resolverdata/*" LogicalName="Rovunet.ResolverData.%(Filename)%(Extension)" /></ItemGroup>
<ItemGroup><PackageReference Include="ZXing.Net" Version="0.16.11" /><PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" /><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" /><EmbeddedResource Include="../../contracts/status2/generated-fixtures.json" LogicalName="Rovunet.Status2.GeneratedFixtures" /><EmbeddedResource Include="../../contracts/status2/positive-examples.json" LogicalName="Rovunet.Status2.PositiveExamples" /></ItemGroup>
<ItemGroup><Content Include="HtmlShell/**/*" CopyToOutputDirectory="PreserveNewest" /><Content Include="Assets/Vazirmatn.ttf" Link="HtmlShell/Vazirmatn.ttf" CopyToOutputDirectory="PreserveNewest" /><Content Include="Assets/rovunet.svg" Link="HtmlShell/rovunet.svg" CopyToOutputDirectory="PreserveNewest" /><Content Include="Assets/iran-lion-sun.svg" Link="HtmlShell/iran-lion-sun.svg" CopyToOutputDirectory="PreserveNewest" /></ItemGroup><ItemGroup><EmbeddedResource Include="../../contracts/sliptrust29/slipstream-trust-v1.synthetic.json" LogicalName="Rovunet.SlipTrust29.Sample" /></ItemGroup>  <!-- Independently approved, pinned Ed25519 public key supplied at build time. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RovunetFreeEd25519PublicKey</_Parameter1>
      <_Parameter2>$(RovunetFreePublicKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
