<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Rovunet.Core/Rovunet.Core.csproj" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <Compile Include="../../src/Rovunet.Desktop/RovunetFreeCatalog.cs" Link="RovunetFreeCatalog.cs" />
    <Compile Include="../../src/Rovunet.Desktop/PublicFeed.cs" Link="PublicFeed.cs" />
    <Compile Include="../../src/Rovunet.Desktop/SubscriptionClient.cs" Link="SubscriptionClient.cs" />
    <Compile Include="../../src/Rovunet.Desktop/MahsaFeed28.cs" Link="MahsaFeed28.cs" />
    <!-- Public RFC 8032 fixture key and fixture AES key, never production trust roots.
         The catalog address points at a synthetic repository path, never the real one. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RovunetFreeEd25519PublicKey</_Parameter1>
      <_Parameter2>11qYAYKxCrfVS/7TyWQHOg7hcvPapiMlrwIaaPcHURo=</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RovunetFreeAesKey</_Parameter1>
      <_Parameter2>AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RovunetFreeCatalogAddress</_Parameter1>
      <_Parameter2>https://raw.githubusercontent.com/msVPNco/rovunet-app/fixture/free/v2/catalog.json</_Parameter2>
    </AssemblyAttribute>
    <!-- The debug opt-in that a public package never sets; the fixture needs it. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RovunetFreeDebug</_Parameter1>
      <_Parameter2>1</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
