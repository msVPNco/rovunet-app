<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Local-only live check for Rovunet Free v2. It is built and run by hand
         against a debug catalog; it is never part of a packaged release. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Rovunet.Core/Rovunet.Core.csproj" />
    <ProjectReference Include="../../src/Rovunet.Platform/Rovunet.Platform.csproj" />
    <ProjectReference Include="../../src/Rovunet.Agent/Rovunet.Agent.csproj" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <Compile Include="../../src/Rovunet.Desktop/RovunetFreeCatalog.cs" Link="RovunetFreeCatalog.cs" />
    <Compile Include="../../src/Rovunet.Desktop/PublicFeed.cs" Link="PublicFeed.cs" />
    <Compile Include="../../src/Rovunet.Desktop/SubscriptionClient.cs" Link="SubscriptionClient.cs" />
    <Compile Include="../../src/Rovunet.Desktop/MahsaFeed28.cs" Link="MahsaFeed28.cs" />
  </ItemGroup>
</Project>
